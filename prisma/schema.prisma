generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id             String   @id @default(uuid())
  bookingId      String
  name           String
  email          String
  phone          String
  roomId         String
  checkIn        DateTime
  checkOut       DateTime
  amount         Float
  pdfUrl String?
  bookingStatus  String
  paymentStatus  String
}

model Room {
  id           String   @id @default(uuid())
  roomNumber   String   @unique
  roomType     String
  price        Float
  capacity     Int
  description  String?
  isAvailable  Boolean  @default(true)
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}